# Optional reference only: commands do not automatically load this file.
# Replace /absolute/path/to/Pipeline with your checkout, or export using $PWD.
PIPELINEIQ_DATABASE_URL="host=/absolute/path/to/Pipeline/.cache/postgres-socket port=55432 dbname=pipelineiq"
# Dedicated database for tests; never point this at a production database.
PIPELINEIQ_TEST_DATABASE_URL="host=/absolute/path/to/Pipeline/.cache/postgres-socket port=55432 dbname=pipelineiq_test"
